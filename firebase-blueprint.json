{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "balance": { "type": "number", "description": "Current wallet balance" },
        "phoneNumber": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "WalletRequest": {
      "title": "Wallet Request",
      "description": "Requests to charge the user's wallet",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "bank": { "type": "string", "enum": ["bok", "rajhi"] },
        "receiptUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Activity": {
      "title": "Account Activity",
      "description": "History of transactions and status changes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["charge", "purchase", "refund"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders for packages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "amount": { "type": "integer" },
        "price": { "type": "string" },
        "currency": { "type": "string" },
        "symbol": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_payment", "pending_verification", "processing", "completed", "failed"] },
        "paymentMethod": { "type": "string", "enum": ["stc_pay", "al_rajhi", "binance_pay", "urpay", "bok"] },
        "paymentId": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "receiptUrl": { "type": "string", "description": "URL of the uploaded payment receipt image" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      }
    },
    "Package": {
      "title": "UC Package",
      "description": "Available PUBG UC top-up packages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "integer" },
        "price_sar": { "type": "number" },
        "price_sdg": { "type": "number" },
        "bonus": { "type": "integer" },
        "image": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["amount", "price_sar", "price_sdg"]
    },
    "SupportChat": {
      "title": "Support Chat",
      "description": "Customer support chat session",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "waiting", "talking", "closed"] },
        "assignedTo": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Individual message in a support chat",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "agent", "ai"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Users of the application"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Orders made by users"
    },
    "packages/{packageId}": {
      "schema": "Package",
      "description": "UC top-up packages"
    },
    "wallet_requests/{requestId}": {
      "schema": "WalletRequest",
      "description": "User requests to charge wallet"
    },
    "activities/{activityId}": {
      "schema": "Activity",
      "description": "User account activity log"
    },
    "support_chats/{chatId}": {
      "schema": "SupportChat",
      "description": "Support chat sessions"
    },
    "support_chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages in a support chat"
    }
  }
}
